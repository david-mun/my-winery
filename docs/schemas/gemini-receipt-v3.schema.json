{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "merchant": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "purchased_on": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "type": "string",
      "enum": [
        "KRW",
        "UNKNOWN",
        "OTHER"
      ]
    },
    "paid_amount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "discount_amount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "lines": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "wine",
              "bundle",
              "other",
              "unknown"
            ]
          },
          "raw_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "printed_quantity": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "wines": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "vintage_label": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(UNKNOWN|NV|[12][0-9]{3})?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quantity": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "details": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "name_ko": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "name_en": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "producer": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "country": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "region": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "grapes": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          }
                        },
                        "alcohol_percent": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "min": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 100
                                },
                                "max": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 100
                                }
                              },
                              "required": [
                                "min",
                                "max"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "high",
                            "medium",
                            "low"
                          ]
                        },
                        "notes": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "summary_ko": {
                          "default": null,
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "name_ko",
                        "name_en",
                        "producer",
                        "country",
                        "region",
                        "grapes",
                        "alcohol_percent",
                        "confidence",
                        "notes"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "quantity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "raw_label",
          "printed_quantity",
          "unit_price",
          "amount",
          "wines"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "merchant",
    "purchased_on",
    "currency",
    "paid_amount",
    "discount_amount",
    "lines",
    "warnings"
  ],
  "additionalProperties": false
}
