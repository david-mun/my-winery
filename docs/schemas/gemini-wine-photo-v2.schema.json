{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bottle_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "bottles": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position_left_to_right": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "source_photo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "bottle_box": {
            "anyOf": [
              {
                "minItems": 4,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "observed": {
            "type": "object",
            "properties": {
              "bottle_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "wine": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "producer": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "wine_type": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "red",
                              "white",
                              "sparkling",
                              "rose",
                              "dessert",
                              "fortified",
                              "other"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "country": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "region": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "grapes": {
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "vintage_label": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^(UNKNOWN|NV|[12][0-9]{3})?$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "alcohol_percent": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "bottle_volume_ml": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 30000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "label_description": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "summary_ko": {
                        "default": null,
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "producer",
                      "wine_type",
                      "country",
                      "region",
                      "grapes",
                      "alcohol_percent",
                      "bottle_volume_ml",
                      "label_description"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "name",
                        "producer",
                        "wine_type",
                        "country",
                        "region",
                        "grapes",
                        "vintage_label",
                        "alcohol_percent",
                        "bottle_volume_ml",
                        "label_description"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "field",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "warnings": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            },
            "required": [
              "bottle_count",
              "wine",
              "evidence",
              "warnings"
            ],
            "additionalProperties": false
          },
          "product_candidate": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name_ko": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "name_en": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "producer": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "country": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "region": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "grapes": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "alcohol_percent": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "min": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "max": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        },
                        "required": [
                          "min",
                          "max"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "notes": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "summary_ko": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name_ko",
                  "name_en",
                  "producer",
                  "country",
                  "region",
                  "grapes",
                  "alcohol_percent",
                  "confidence",
                  "notes"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "position_left_to_right",
          "observed",
          "product_candidate"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "bottle_count",
    "bottles",
    "warnings"
  ],
  "additionalProperties": false
}
