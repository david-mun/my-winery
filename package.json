{
  "name": "my-wine-list",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/database.test.ts",
    "test:e2e": "playwright test",
    "import:snapshot": "node --import tsx scripts/import-snapshot.ts",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs",
    "bootstrap:admin": "node --import tsx scripts/bootstrap-admin.ts",
    "predev": "node tooling/prepare-ocr.mjs",
    "prebuild": "node tooling/prepare-ocr.mjs",
    "db:migrate": "node tooling/migrate-db.mjs",
    "test:postgres": "node tooling/test-postgres.mjs",
    "owner:setup": "node --import tsx scripts/commission-owner.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.67.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
