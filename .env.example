# Copy to .env.local. Never put real keys in this example file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local migration operator only (optional). Supabase Connect → Session pooler.
# Do not set NEXT_PUBLIC_ or put this connection URL in client/deployment config.
SUPABASE_DB_URL=

# Server-only image analysis. No NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set false to turn off external image analysis. Enabled when a key is configured.
GEMINI_ANALYSIS_ENABLED=true
